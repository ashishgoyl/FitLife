# ========================================================
# FitLife Configuration Template (.env.example)
# ========================================================

# Google Gemini API Key for AI Health Coach
# (Leave empty to use FitLife built-in smart coaching fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth 2.0 Client ID for Google Sign-In
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Backend API Port (Default: 5001)
PORT=5001

# Optional SMS / WhatsApp Gateway Keys
# CALLMEBOT_API_KEY=your_callmebot_api_key
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_token
# TWILIO_FROM_NUMBER=your_twilio_number
# FAST2SMS_API_KEY=your_fast2sms_key
# RAPIDAPI_KEY=your_rapidapi_key

